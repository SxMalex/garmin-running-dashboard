# Identifiants Garmin Connect — ne commite jamais le fichier .env réel.
# Si renseignés, l'app se connecte automatiquement au démarrage (un code MFA
# peut être demandé dans l'interface la première fois). Sinon, un formulaire
# de connexion s'affiche.
GARMIN_EMAIL=ton.email@exemple.com
GARMIN_PASSWORD=ton_mot_de_passe

# Emplacement du cache de session Garmin (tokens OAuth garth, valides ~1 an).
# Défaut : /app/.garmin dans Docker, ~/.garminconnect hors Docker.
# GARMIN_TOKENSTORE=/app/.garmin

# Durée du cache disque des appels API, en secondes
CACHE_TTL=3600

# Clé API OpenRouteService — nécessaire pour la page Prochaine sortie
# Inscription gratuite sur https://openrouteservice.org/dev/#/signup
ORS_API_KEY=ta_cle_ors

# ─── Production uniquement (docker-compose.prod.yml) ─────────────────────
# Domaine public servi par Caddy avec HTTPS auto via Let's Encrypt
PUBLIC_DOMAIN=garmin.exemple.com
ACME_EMAIL=admin@exemple.com

# Indispensable en prod : Streamlit annonce ce hostname au navigateur pour
# que la WebSocket se reconnecte au bon domaine.
STREAMLIT_BROWSER_SERVER_ADDRESS=garmin.exemple.com
